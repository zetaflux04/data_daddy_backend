# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=super_secret_jwt_key_repairshop_2025
JWT_EXPIRES_IN=7d

# MongoDB (e.g. mongodb://localhost:27017/repairshop or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/repairshop

# Redis (for OTP cache and BullMQ job queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Fast2SMS (Indian OTP & SMS Gateway)
# Set to 'mock' for local dev without sending live SMS
FAST2SMS_API_KEY=mock
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=TXTIND

# Razorpay (Subscription & Pro Access)
RAZORPAY_KEY_ID=mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# AWS S3 (Temporarily commented out - switching to Cloudinary)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=mock_aws_key
# AWS_SECRET_ACCESS_KEY=mock_aws_secret
# AWS_S3_BUCKET_NAME=repairshop-manager-storage

# Cloudinary (Repair Guides, Schematics, Invoice & Media Storage)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=mock_cloudinary_key
CLOUDINARY_API_SECRET=mock_cloudinary_secret

